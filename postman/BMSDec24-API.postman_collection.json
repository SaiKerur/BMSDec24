    {
      "name": "Users",
      "item": [
        {
          "name": "POST /api/users/signup - success (unique email)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomSuffix = Date.now() + '_' + Math.floor(Math.random() * 10000);",
                  "const email = `bms_${randomSuffix}@example.com`;",
                  "pm.collectionVariables.set('existingEmail', email);",
                  "pm.variables.set('signupEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response status is SUCCESS', function () {",
                  "    pm.expect(json.responseStatus).to.eql('SUCCESS');",
                  "});",
                  "",
                  "pm.test('User id is present', function () {",
                  "    pm.expect(json.userId).to.be.a('number');",
                  "    pm.expect(json.userId).to.be.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('signedUpUserId', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
