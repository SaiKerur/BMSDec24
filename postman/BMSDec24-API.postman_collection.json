      "name": "Tickets - Booking",
      "item": [
        {
          "name": "POST /api/tickets/book - success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const signedUpUserId = pm.collectionVariables.get('signedUpUserId');",
                  "const fallbackUserId = pm.collectionVariables.get('validUserId');",
                  "pm.variables.set('bookingUserId', signedUpUserId || fallbackUserId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Ticket id exists', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.id).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Ticket status is PENDING', function () {",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "});",
                  "",
                  "pm.collectionVariables.set('ticketId', json.id);"
                ]
              }
            }
