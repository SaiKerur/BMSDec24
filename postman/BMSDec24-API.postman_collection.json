    {
      "name": "Auth",
      "description": "JWT-based login/refresh/me flows. Run Users → Signup success first so loginEmail/loginPassword are populated, then run Login success to populate accessToken/refreshToken.",
      "item": [
        {
          "name": "POST /api/auth/login - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('accessToken is present', function () {",
                  "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('refreshToken is present', function () {",
                  "    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('tokenType is Bearer', function () {",
                  "    pm.expect(String(json.tokenType || '').toLowerCase()).to.eql('bearer');",
                  "});",
                  "",
                  "pm.test('accessTokenExpiresAt is in the future', function () {",
                  "    pm.expect(Number(json.accessTokenExpiresAt)).to.be.above(Date.now());",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "if (json.userId) {",
                  "    pm.collectionVariables.set('signedUpUserId', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates with the freshly signed-up user. Stores accessToken + refreshToken as collection variables for downstream protected calls."
          },
          "response": []
