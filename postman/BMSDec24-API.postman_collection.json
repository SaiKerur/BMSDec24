    {
      "name": "Bookings",
      "description": "Book seats for a movie at a theatre (PENDING). Run Auth login first.",
      "item": [
        {
          "name": "POST /api/bookings/book - success (stores bookingId)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.collectionVariables.get('signedUpUserId') || pm.collectionVariables.get('validUserId');",
                  "pm.variables.set('bookingUserId', u);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Booking is PENDING', function () { pm.expect(json.status).to.eql('PENDING'); });",
                  "pm.collectionVariables.set('bookingId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
